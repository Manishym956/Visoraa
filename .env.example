API_HOST=127.0.0.1
API_PORT=8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
MAX_IMAGE_BYTES=8388608

# Provider: mock (default) | pipeline | gemini | groq | openai
# pipeline = Groq reads the image -> Gemini writes the lesson -> Groq answers tutor questions
VL_PROVIDER=pipeline

# Gemini (preferred live path)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_API_KEY=   # accepted as alias for GEMINI_API_KEY

# OpenAI-compatible (optional)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Groq (OpenAI-compatible, fast). Qwen 3.8 27B reads images and supports JSON mode (Llama 4 Scout was retired).
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MAX_TOKENS=1000   # free tier = 1000 output tokens/min; raise on Dev tier
